TELEGRAM_BOT_TOKEN=put-your-telegram-token-here

POSTGRES_DB=dating
POSTGRES_USER=dating
POSTGRES_PASSWORD=dating
DATABASE_URL=postgresql+psycopg://dating:dating@postgres:5432/dating

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EVENTS_QUEUE=dating.events
ENABLE_MQ_PUBLISH=true

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=dating-photos
S3_PUBLIC_BASE_URL=http://minio:9000/dating-photos

# Optional. If set, bot and API must share this token via X-API-Token.
API_SERVICE_TOKEN=

# true — включает /reset в боте и POST /dev/reset_user_state (для тестов перед сдачей)
ENABLE_DEV_ENDPOINTS=false

API_BASE_URL=http://api:8000
